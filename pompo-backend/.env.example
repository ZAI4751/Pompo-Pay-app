# Application
APP_ENV=development
APP_NAME=POMPO
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-64-char-random-string-in-production-please-use-secrets
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
# Browser origins allowed to call the API. "localhost" and "127.0.0.1" are
# DIFFERENT origins to a browser, so list every one the admin frontend is
# actually opened as. Production must be restricted to real deployed origins.
#
# When the Master Admin is on Vercel, add the deployed admin origin(s), e.g.:
#   https://admin.pompo.example
#   https://your-project.vercel.app
# See pompo-frontend/docs/admin-deployment.md for the full CORS matrix.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://pompo:pompo_secret@postgres:5432/pompo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (per client IP, sliding window)
# Inside Docker every request from the host arrives with the gateway's IP, so
# one bucket is shared by the whole development session. Leave this unset for
# local work to pick up the higher development default.
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Provider configuration (references only — never put live secrets here).
# Each rail looks up:
#   PROVIDER_<CODE>_ENVIRONMENT        sandbox | production (optional override)
#   PROVIDER_<CODE>_BASE_URL
#   PROVIDER_<CODE>_TIMEOUT_SECONDS    (default 15)
#   PROVIDER_<CODE>_CREDENTIAL_REF     (name of another env var that holds the secret)
#   PROVIDER_<CODE>_WEBHOOK_SECRET_REF
# Example (do not commit the actual secret value):
# PROVIDER_AIRTEL_MONEY_ENVIRONMENT=sandbox
# PROVIDER_AIRTEL_MONEY_BASE_URL=
# PROVIDER_AIRTEL_MONEY_TIMEOUT_SECONDS=15
# PROVIDER_AIRTEL_MONEY_CREDENTIAL_REF=AIRTEL_MONEY_CLIENT_SECRET
# AIRTEL_MONEY_CLIENT_SECRET=
# Development and testing use simulated adapters; they do not require these variables.
# Production rails and production credentials cannot be used unless APP_ENV=production.
# Inject secrets through the runtime environment or a secret manager, not source control.

# Local Master Admin bootstrap (development only). Used by scripts/seed_admin.py.
# Never commit a real password. The script refuses to run when APP_ENV=production.
# POMPO_ADMIN_EMAIL=you@example.com
# POMPO_ADMIN_PASSWORD=
