# Base URL of the Pompo FastAPI backend (see pompo-backend/docs/architecture.md).
# Never commit a real value here -- this file documents the variable name only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Set to "true" to force the mock data layer even if NEXT_PUBLIC_API_BASE_URL
# is reachable. Useful for UI development against endpoints that don't exist
# in the backend yet (see docs/admin-ui-architecture.md, "Mock/API boundary").
NEXT_PUBLIC_USE_MOCKS=true
