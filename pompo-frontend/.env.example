# =============================================================================
# POMPO Master Admin — environment variables
# =============================================================================
# Copy to .env.local for local development. Never commit real secrets here.
#
# On Vercel, set these in Project → Settings → Environment Variables.
# See docs/admin-deployment.md for Development / Preview / Production matrix.
# =============================================================================

# --- Required on Vercel Preview and Production ---
# HTTPS URL of the deployed FastAPI API including the /api/v1 prefix.
# Examples:
#   Production: https://api.pompo.example/api/v1
#   Preview:    https://api-staging.pompo.example/api/v1
#   Local only: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Optional (default: live API) ---
# Set to "true" ONLY for local or Vercel Preview demo fixtures.
# MUST be false or unset on Vercel Production — the build fails if enabled.
NEXT_PUBLIC_USE_MOCKS=false
