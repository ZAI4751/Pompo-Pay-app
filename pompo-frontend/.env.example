# Base URL of the Pompo FastAPI backend (see pompo-backend/docs/architecture.md).
# Never commit a real value here -- this file documents the variable name only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Default is live API. Set to "true" only for labeled demo fixtures without Docker.
# When unset or "false", the Master Admin calls /api/v1 for every capability the
# backend already exposes. Live sign-in requires a seeded platform administrator
# (see pompo-backend/docs/testing.md, "Creating an admin account").
NEXT_PUBLIC_USE_MOCKS=false
